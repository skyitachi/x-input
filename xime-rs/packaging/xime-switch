#!/bin/sh
# xime-switch - 在 xime 与 fcitx5 之间互相切换。
#
#   xime-switch            按当前谁在跑取反
#   xime-switch xime       明确切到 xime
#   xime-switch fcitx5     明确切到 fcitx5
#
# 原则：怎么启动的就怎么停。
#   - systemd 用户单元（Omarchy 的 omarchy-fcitx5.service 带 Restart=always，
#     光 pkill 两秒后就被拉回来）→ 必须 systemctl stop/disable；
#   - 会话启动项拉起的 → pkill / 直接拉起新的。
# xime 内置单实例锁，切换过程中两边的进程就算短暂重叠也不会抢席位。
#
# KDE 上输入法由 KWin 管理，切换 = 改 kwinrc 的 InputMethod 并通知 KWin 重载。
# KWin 6.6 只提供 zwp_input_method_v1，xime 已实现这个前端（--frontend auto 自动
# 识别）。desktop 的 Exec 指向 xime-both：由它同时拉起 Wayland 前端与 DBus 前端，
# 两个进程各服务一类应用；详见 packaging/xime-both 与 README「双进程模式」。

set -eu

XIME=${XIME_BIN:-}
if [ -z "$XIME" ]; then
    for _b in "${HOME}/.local/bin/xime" /usr/bin/xime /usr/local/bin/xime; do
        [ -x "$_b" ] && { XIME=$_b; break; }
    done
    : "${XIME:=/usr/bin/xime}"
fi

# 双进程启动器：找不到时退回单进程（旧安装仍可工作）
XIME_BOTH=${XIME_BOTH_BIN:-}
if [ -z "$XIME_BOTH" ]; then
    for _b in "${XIME%/*}/xime-both" /usr/bin/xime-both /usr/local/bin/xime-both; do
        [ -x "$_b" ] && { XIME_BOTH=$_b; break; }
    done
fi
: "${XIME_BOTH:=$XIME}"
FCITX=${FCITX_BIN:-/usr/bin/fcitx5}
XIME_UNIT=xime.service
LOG=${XDG_STATE_HOME:-${HOME}/.local/state}/xime.log

say() { printf '%s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }
running() { pgrep -x "$1" >/dev/null 2>&1; }

# 判断某 PID 是不是 xime-both 启动器：它的 cmdline 形如
#   /bin/sh /path/to/xime-both [--dbus-only]
# 只看 argv[1]（脚本路径），避免把命令行里恰好带这几个字的进程误判进来。
proc_is_both() {
    [ -r "/proc/$1/cmdline" ] || return 1
    tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null | sed -n '2p' | grep -q 'xime-both$'
}

# 找 xime-both 启动器。优先读它自己写的 PID 文件；读不到按进程名兜底。
# 注意：shebang 脚本的 comm 取的是**脚本名**，所以 `pgrep -x xime-both` 有效，
# 但 `pgrep -x sh` 找不到它（这一点实测确认，别凭直觉写 sh）。
xime_both_pids() {
    _pf="${XDG_RUNTIME_DIR:-/tmp}/xime-both.pid"
    if [ -r "$_pf" ]; then
        _bp=$(cat "$_pf" 2>/dev/null || true)
        if [ -n "$_bp" ] && proc_is_both "$_bp"; then
            printf '%s\n' "$_bp"
            return 0
        fi
    fi
    for _bp in $(pgrep -x xime-both 2>/dev/null || true); do
        proc_is_both "$_bp" && printf '%s\n' "$_bp"
    done
    return 0
}

systemd_ready() {
    have systemctl || return 1
    dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    [ -d "$dir/systemd" ]
}

unit_installed() {
    u=$1
    [ -f "/usr/lib/systemd/user/$u" ] || [ -f "${HOME}/.config/systemd/user/$u" ]
}

unit_active() { systemctl --user is-active --quiet "$1" 2>/dev/null; }

# fcitx5 的 systemd 单元（Omarchy 用 omarchy-fcitx5.service，发行版也可能叫 fcitx5.service）
fcitx_units() {
    for u in omarchy-fcitx5.service fcitx5.service; do
        unit_installed "$u" && printf '%s\n' "$u"
    done
}

fcitx_desktop() {
    for d in /usr/share/applications/org.fcitx.Fcitx5.desktop \
             /usr/share/applications/fcitx5-wayland-launcher.desktop; do
        [ -f "$d" ] && { printf '%s' "$d"; return 0; }
    done
    printf '%s' "${FCITX}"
}

current() {
    if running xime; then
        echo xime
    elif running fcitx5; then
        echo fcitx5
    else
        echo none
    fi
}

# 输入法服务重启后，长驻的 fcitx5-qt 客户端（Omarchy 的 Quickshell 启动器/状态栏）
# 不会因 org.fcitx.Fcitx5 的服务名易主而自动重建输入上下文 —— 表现为启动器搜索框
# 「完全没反应」（键既不组字也不上屏），而同时间新启动的应用（nautilus 等）却正常。
# 唯一可靠的恢复办法是重启 shell，让它重新 CreateInputContext 连到当前服务。
# 用 XIME_NO_SHELL_RESTART=1 可跳过（例如自动化脚本里不想闪一下状态栏）。
reconnect_shell() {
    [ "${XIME_NO_SHELL_RESTART:-0}" = "1" ] && return 0
    have omarchy-restart-shell || return 0
    pgrep -x quickshell >/dev/null 2>&1 || return 0
    say "  重连 Omarchy shell（让启动器/状态栏接到新输入法服务）…"
    omarchy-restart-shell >/dev/null 2>&1 \
        && say "  shell 已重连 ✅" \
        || say "  ⚠ shell 重连未完成（可能在锁屏中；解锁后手动 omarchy-restart-shell）"
}

start_xime() {
    if systemd_ready && unit_installed "$XIME_UNIT"; then
        systemctl --user enable --quiet "$XIME_UNIT" 2>/dev/null || true
        if unit_active "$XIME_UNIT"; then
            systemctl --user restart --quiet "$XIME_UNIT"
        else
            systemctl --user start --quiet "$XIME_UNIT"
        fi
        say "  xime 已启动（systemd 用户单元，登录自启）"
    else
        mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
        setsid -f "$XIME_BOTH" >>"$LOG" 2>&1
        say "  xime 已启动（双进程模式，日志: $LOG）"
    fi
    # 双进程模式下两条通道同时存在：
    #   Wayland 应用（未设 IM 变量）→ 原生 text-input
    #   XWayland / X11 / 自带 fcitx5 模块的应用 → DBus
    # 后者只要应用启动时带着 QT_IM_MODULE / GTK_IM_MODULE 即可，
    # 值写 **fcitx 或 fcitx5 都一样**（插件按服务名选协议，2026-11-22 实测）。
    say "  提示：XWayland/X11 应用用中文需要 QT_IM_MODULE=fcitx（或 fcitx5）"
    reconnect_shell
}

stop_xime() {
    if systemd_ready && unit_installed "$XIME_UNIT"; then
        systemctl --user disable --quiet "$XIME_UNIT" 2>/dev/null || true
        systemctl --user stop --quiet "$XIME_UNIT" 2>/dev/null || true
        say "  xime 已停止并取消自启"
    fi
    # 启动器要显式停掉：它是独立进程，pgrep -x xime 抓不到它。
    # 先给它发 TERM，让它按自己的 trap 回收 DBus 子进程；
    # 只杀 xime 的话，启动器会把 DBus 那半守着，org.fcitx.Fcitx5 一直不释放。
    if [ -n "$(xime_both_pids)" ]; then
        for _p in $(xime_both_pids); do
            kill "$_p" 2>/dev/null || true
        done
        say "  xime-both 启动器已终止（子进程随之回收）"
    fi
    if running xime; then
        pkill -x xime || true
        say "  xime 进程已终止"
    fi
    # 双进程模式下 DBus 那一半占着 org.fcitx.Fcitx5；名字没释放，fcitx5 起不来。
    # 等它退干净再往下走，别让切换卡在「fcitx5 已启动但没接管」。
    i=0
    while [ "$i" -lt 25 ]; do
        running xime && _alive=1 || _alive=0
        if [ -n "$(xime_both_pids)" ]; then _alive=1; fi
        [ "$_alive" -eq 0 ] && break
        i=$((i + 1))
        sleep 0.2
    done
}

start_fcitx5() {
    started=""
    if systemd_ready; then
        for u in $(fcitx_units); do
            systemctl --user enable --quiet "$u" 2>/dev/null || true
            if systemctl --user start --quiet "$u" 2>/dev/null; then
                started="$u"
                break
            fi
        done
    fi
    if [ -n "$started" ]; then
        say "  fcitx5 已启动（systemd 用户单元 $started，登录自启）"
    elif ! running fcitx5; then
        if [ -x "$FCITX" ]; then
            fcitx5 -d >/dev/null 2>&1 || true
            say "  fcitx5 已启动（daemon 模式）"
        else
            say "  未找到 fcitx5，没法切过去（pacman -S fcitx5）"
            return 1
        fi
    else
        say "  fcitx5 已在运行"
    fi
    reconnect_shell
}

stop_fcitx5() {
    # Restart=always 的单元必须先 disable+stop，否则 pkill 完 2 秒又被拉回来
    if systemd_ready; then
        for u in $(fcitx_units); do
            systemctl --user disable --quiet "$u" 2>/dev/null || true
            systemctl --user stop --quiet "$u" 2>/dev/null || true
            say "  已停止并停用 $u"
        done
    fi
    if running fcitx5; then
        pkill -x fcitx5 || true
        say "  fcitx5 进程已终止"
    fi
}

# KDE：输入法生命周期归 KWin，切换 = 改 kwinrc 并让它重载

# 写 InputMethod 并通知 KWin。用相对文件名 kwinrc（KConfig 在 ~/.config 下找），
# 实测绝对路径的 --notify 有时不触发 KWin 重载。
kde_write_im() {
    _im=$1
    _f=${KWINRC:-${HOME}/.config/kwinrc}
    if have kwriteconfig6; then
        kwriteconfig6 --file kwinrc --group Wayland --key InputMethod "$_im" --notify
    else
        tmp=$(mktemp)
        awk -v im="$_im" '
            BEGIN { inw = 0; set = 0 }
            /^\[/ { if (inw && !set) { print "InputMethod=" im; set = 1 }
                    inw = ($0 == "[Wayland]"); print; next }
            inw && /^InputMethod(\[\$e\])?=/ { print "InputMethod=" im; set = 1; next }
            { print }
            END { if (inw && !set) print "InputMethod=" im }
        ' "$_f" > "$tmp" && install -m 644 "$tmp" "$_f" && rm -f "$tmp"
    fi
}

# 读当前 InputMethod：优先用 kreadconfig6（能处理 [$e] 展开），回退直接读文件。
kde_current_im() {
    f=${KWINRC:-${HOME}/.config/kwinrc}
    if have kreadconfig6; then
        kreadconfig6 --file "$f" --group Wayland --key InputMethod 2>/dev/null || true
    else
        grep -hE '^InputMethod(\[\$e\])?=' "$f" 2>/dev/null | tail -n1 | sed 's/^InputMethod\(\[\$e\]\)\?=//'
    fi
}

# 找 xime 的 desktop 文件（KDE 切换只认 .desktop，不认裸二进制路径）。
kde_xime_desktop() {
    for d in "${XIME_DESKTOP:-}" \
             "${HOME}/.local/share/applications/xime.desktop" \
             /usr/share/applications/xime.desktop; do
        [ -n "$d" ] && [ -f "$d" ] && { printf '%s' "$d"; return 0; }
    done
    # 没有 desktop 就临时造一个。Exec 指向 xime-both：由它同起 Wayland 与 DBus
    # 两个前端（找不到 xime-both 时 XIME_BOTH 已回退成二进制本身）。
    # 注意别在 Exec 里写 `--dbus`：那样 KWin 拉起的这份就不实现 Wayland 前端了。
    d="${XIME_DESKTOP:-${HOME}/.local/share/applications/xime.desktop}"
    mkdir -p "$(dirname "$d")"
    cat >"$d" <<EOF
[Desktop Entry]
Type=Application
Name=xime
GenericName=Input Method
Comment=Wayland-native Chinese input method
Exec=${XIME_BOTH}
Icon=input-keyboard
Terminal=false
Categories=Utility;
NoDisplay=true
StartupNotify=false
X-KDE-StartupNotify=false
X-KDE-Wayland-VirtualKeyboard=true
EOF
    have update-desktop-database && update-desktop-database "$(dirname "$d")" >/dev/null 2>&1 || true
    say "KDE: 已自动创建 $d（Exec=$XIME_BOTH）"
    printf '%s' "$d"
}

kde_switch() {
    target=$1
    f=${KWINRC:-${HOME}/.config/kwinrc}
    im_now=$(kde_current_im)

    if [ "$target" = xime ]; then
        im=$(kde_xime_desktop)
    else
        im=$(fcitx_desktop)
    fi

    if [ "$im" = "$im_now" ]; then
        say "KDE: 当前已是 $im，无需切换"
        return 0
    fi

    # KWin 6.6 对单次 InputMethod 变更经常不重载；两段式（先切到对端再切回目标）
    # 实测能强制它卸载旧输入法、加载新的，切换当场生效。
    if [ "$target" = xime ]; then
        other=$(fcitx_desktop)
    else
        other=$(kde_xime_desktop)
    fi
    kde_write_im "$other"
    sleep 2
    kde_write_im "$im"
    say "KDE: InputMethod → $im"

    # 等 KWin 重载拉起目标输入法（最多 ~10 秒），让切换结果当场可见
    i=0
    while [ "$i" -lt 20 ]; do
        if [ "$target" = xime ]; then
            running xime && break
        else
            running fcitx5 && break
        fi
        i=$((i + 1))
        sleep 0.5
    done
    if [ "$target" = xime ]; then
        running xime && say "  xime 已由 KWin 拉起 ✅" || say "  ⚠ xime 未启动，可能需要注销重登"
    else
        running fcitx5 && say "  fcitx5 已由 KWin 拉起 ✅" || say "  ⚠ fcitx5 未启动"
    fi
}

usage() {
    cat <<EOF
用法: xime-switch [xime|fcitx5]

  无参数      按当前谁在跑取反（xime ⇄ fcitx5）
  xime        切到 xime
  fcitx5      切到 fcitx5
EOF
}

target=${1:-}
case "$target" in
    -h|--help) usage; exit 0 ;;
    xime|fcitx5) ;;
    "")
        case "$(current)" in
            xime) target=fcitx5 ;;
            *) target=xime ;;
        esac
        ;;
    *) usage; exit 2 ;;
esac

d=$(printf '%s' "${XDG_CURRENT_DESKTOP:-${XDG_SESSION_DESKTOP:-}}" | tr '[:upper:]' '[:lower:]')
case "$d" in
    *kde*|*plasma*)
        kde_switch "$target"
        exit $?
        ;;
    *gnome*)
        if [ "$target" = xime ]; then
            say "GNOME/Mutter 不支持 zwp_input_method_v2，xime 在 GNOME 上不可用。"
            exit 1
        fi
        ;;
esac

from=$(current)
say "切换输入法: ${from:-none} → $target"
if [ "$target" = xime ]; then
    stop_fcitx5
    start_xime
else
    stop_xime
    start_fcitx5
fi
say "当前: $(current)"
