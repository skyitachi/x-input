#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # 系统级默认值：让 KWin 下次启动会话时把 xime 当输入法拉起。
    # 只写 /etc/xdg/kwinrc（系统默认层），不碰任何用户的私有配置。
    if [ -x /usr/bin/xime-setup ]; then
        /usr/bin/xime-setup --kde-default --quiet || true
    fi
    # 给当前登录用户接线（systemd 单元 / sway/Hyprland/labwc 启动项）。
    # su 不带 XDG_RUNTIME_DIR，systemctl --user 找不到用户管理器的 socket，得补上。
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        su -s /bin/sh "$SUDO_USER" -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u); xime-setup --auto --quiet' || true
    fi
fi
exit 0
