# pacman 安装/卸载钩子，等价于 deb 的 postinst / postrm。

post_install() {
    # 系统级默认值：让 KWin 下次启动会话时把 xime 当输入法拉起。
    # 只写 /etc/xdg/kwinrc（系统默认层），不碰任何用户的私有配置。
    if [ -x /usr/bin/xime-setup ]; then
        /usr/bin/xime-setup --kde-default --quiet || true
    fi
    # sudo pacman -U 时把当前登录用户接上（systemd 单元 / 会话启动项）
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        su -s /bin/sh "$SUDO_USER" -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u); xime-setup --auto --quiet' || true
    fi

    # 可选依赖提示：X11/XWayland 应用输入需 fcitx5 客户端模块（post_install 在
    # pacman 事务内跑，不能嵌套 pacman -S，所以这里只提示，安装交给
    # `sudo xime-setup --auto` 或 `sudo pacman -S --needed fcitx5-qt fcitx5-gtk`）。
    echo "提示：X11/XWayland 应用输入需 fcitx5 客户端模块（可选依赖）。"
    echo "      sudo pacman -S --needed fcitx5-qt fcitx5-gtk   # 或 sudo xime-setup --auto"
}

pre_remove() {
    if [ -x /usr/bin/xime-setup ]; then
        /usr/bin/xime-setup --remove-kde-default --quiet || true
    fi
}
